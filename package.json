{
  "name": "@dierkens.dev/ptcgl-battle-log-parser",
  "version": "1.0.0-rc.0",
  "description": "Zero-dependency parser for Pokémon TCG Live battle-log exports. 7 locales, structured AST, no runtime deps.",
  "keywords": [
    "pokemon",
    "ptcg",
    "ptcgl",
    "pokemon-tcg-live",
    "battle-log",
    "battle-log-parser",
    "parser",
    "tcgl"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/cdierkens/ptcgl-battle-log-parser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdierkens/ptcgl-battle-log-parser.git"
  },
  "bugs": {
    "url": "https://github.com/cdierkens/ptcgl-battle-log-parser/issues"
  },
  "scripts": {
    "build": "pnpm run \"/^build:.*/\"",
    "build:clean": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "build:lib": "tsc -p tsconfig.build.json",
    "test": "pnpm run \"/^test:.*/\"",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "templates:refresh": "tsx scripts/refresh-templates.ts",
    "templates:check": "tsx scripts/refresh-templates.ts --check",
    "fixtures:prepare": "tsx scripts/prepare-fixture.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify:ci": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build",
    "verify": "pnpm run templates:check && pnpm run verify:ci",
    "prepublishOnly": "pnpm run verify:ci",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
